# Copy to .env.local for local development. Do not put secrets in NEXT_PUBLIC_* variables.

# Where `next dev` / `next start` forward /api/* (server-side only).
# Local non-Docker default:
API_PROXY_TARGET=http://localhost:8080

# Leave unset: browser requests use /api/v1 on the current origin; Next.js proxies them
# using API_PROXY_TARGET (or the production reverse proxy routes /api to the API).
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Public origin used for canonical URLs, sitemap, robots, llms.txt and JSON-LD (inlined at build).
# Defaults to https://ceritalagu.com; set it for staging builds.
# NEXT_PUBLIC_SITE_URL=https://ceritalagu.com
